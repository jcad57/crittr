{
  "expo": {
    "name": "Crittr",
    "slug": "crittr",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-temp.png",
    "scheme": "crittr",
    "backgroundColor": "#fff7f1",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jcadeichmann.crittr",
      "usesAppleSignIn": true,
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/app-icon-temp.png",
        "backgroundImage": "./assets/images/app-icon-temp.png",
        "monochromeImage": "./assets/images/app-icon-temp.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.jcadeichmann.crittr",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.jcadeichmann.crittr"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withFirebaseSceneDelegate",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-bg.png",
          "imageWidth": 430,
          "resizeMode": "cover",
          "enableFullScreenImage_legacy": true,
          "backgroundColor": "#fff7f1",
          "dark": {
            "backgroundColor": "#fff7f1"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Crittr to access your photos to set profile and pet avatars, and to add medical document photos.",
          "cameraPermission": "Allow Crittr to use your camera to photograph medical documents and pet avatars."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-icon-temp.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      [
        "@react-native-firebase/app",
        {
          "ios": {
            "disableSPM": true
          }
        }
      ],
      [
        "@react-native-firebase/analytics",
        {
          "ios": {
            "googleAppMeasurementOnDeviceConversion": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "forceStaticLinking": [
              "RNFBApp",
              "RNFBAnalytics"
            ]
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8604165196940630~7346651942",
          "iosAppId": "ca-app-pub-8604165196940630~9737740514",
          "userTrackingUsageDescription": "Crittr uses this identifier to show you more relevant ads."
        }
      ],
      [
        "expo-tracking-transparency",
        {
          "userTrackingPermission": "Crittr uses this identifier to show you more relevant ads."
        }
      ],
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.99305086331-nrckp166ef3h0258fiacpptff09o1jc9"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "49a5ae52-3be6-4ecf-a601-a80cc2c5718e"
      }
    },
    "owner": "pegasys-studios"
  }
}
